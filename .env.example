# Copy this file to .env next to app.py (same folder as app.py).
# Do NOT put keys in .venv — that folder is only the Python virtual environment.
# .env is gitignored and loaded automatically when the app starts.

# Required for OpenET (https://etdata.org) western U.S. evapotranspiration.
# Create a key at https://etdata.org/api/
OPENET_API_KEY=

# Optional. USGS Water Data API works without a key at a lower rate limit.
# https://api.waterdata.usgs.gov
# https://api.waterdata.usgs.gov/docs/ogcapi/
USGS_API_KEY=

# NASA POWER needs no key: https://power.larc.nasa.gov/api/pages/
